# vLLM Control 관리 서버 설정 (이 파일을 .env 로 복사해서 채우세요)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 세션 쿠키 서명 키. 비워두면 서버 재시작마다 로그아웃됩니다. 생성: python3 -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=
# 로그인 유지 기간(일)
SESSION_DAYS=14
# 관리 웹 서버 포트 (비우면 8000)
# 8000 은 vLLM 모델 서버의 기본 포트(루트 .env 의 PORT_BASE)와 겹치므로, 모델도 같은 서버에서 띄운다면 다른 번호를 권장
PORT=8000
# 바인드 주소 (기본 0.0.0.0 = 외부 접속 허용, 127.0.0.1 = 이 서버에서만)
HOST=0.0.0.0

# 주소 복사: 실제 모델 포트별 URL (설정한 값 그대로 복사, 미설정 시 http://현재호스트:포트/v1)
# 변경 후 관리 서버를 재시작하세요. 다른 포트도 MODEL_PUBLIC_URL_<포트>로 추가 가능합니다.
MODEL_PUBLIC_URL_8000=llm0.knpu.re.kr/v1
MODEL_PUBLIC_URL_8001=llm1.knpu.re.kr/v1
