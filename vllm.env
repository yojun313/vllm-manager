# ./vllm 공통 설정. vLLM 업그레이드는 VLLM_IMAGE 한 줄만 바꾸면 됩니다.
#
# ⚠️ 이 서버 드라이버는 575 (CUDA 12.9)입니다. 기본 태그(latest, v0.30.0)는 CUDA 13 이미지라
#    드라이버 580 이상이 필요하므로 반드시 "-cu129" 태그를 쓰세요.
#    사용 가능한 태그: https://hub.docker.com/r/vllm/vllm-openai/tags
#
# ⚠️ v0.30.0-cu129 는 공식 이미지 버그로 쓰면 안 됩니다: torch 가 2.14.0+cu130 으로 덮어써져 torchvision(cu129)과
#    안 맞아 "operator torchvision::nms does not exist" 로 죽습니다. (vllm-project/vllm#56829)
#    올릴 때는 이슈가 닫혔는지 확인한 뒤 새 -cu129 태그로 바꾸세요.
VLLM_IMAGE=vllm/vllm-openai:v0.29.0-cu129

# 이미 받아둔 모델 폴더 (컨테이너 안에서는 /models 로 보임)
MODELS_DIR=/mnt/disk/vllm

# HF repo id 로 지정한 모델이 자동 다운로드되는 곳 (컨테이너의 ~/.cache/huggingface)
HF_CACHE_DIR=/mnt/disk/vllm/hf-cache

# torch.compile / CUDA graph 캐시. 두 번째 실행부터 기동이 빨라집니다.
VLLM_CACHE_DIR=/mnt/disk/vllm/vllm-cache

# 사용할 GPU. GPU_IDS(번호 목록)가 GPU_COUNT(앞에서부터 N장)보다 우선하며, 둘 다 비우면 감지된 GPU 전부를 쓴다.
# 예: GPU_COUNT=2  /  GPU_IDS=0,2
GPU_COUNT=2
GPU_IDS=

# 포트 = PORT_BASE + (첫 번째 GPU 번호). GPU0 -> 8000, GPU1 -> 8001, GPU0,1 -> 8000
PORT_BASE=8000

# 포트를 어디에 열지. 0.0.0.0 = 외부에서 접속 가능, 127.0.0.1 = 이 서버 안에서만 접속 가능
BIND_ADDR=0.0.0.0

# ---- 자동 메모리 계산 (lib/plan.py)
# KV 캐시 = max-model-len 길이의 요청 KV_CONCURRENCY 개를 동시에 담을 크기. 모델별로 `# concurrency: N` 주석으로 바꿀 수 있음
KV_CONCURRENCY=4
# max-model-len: auto 일 때, KV 캐시가 이 크기(GiB) 안에 들어가는 가장 긴 컨텍스트를 고름 (최소 32k)
AUTO_KV_GIB=16
# 계산 오차 대비로 GPU 마다 남겨두는 여유 (MiB)
SAFETY_MIB=2048
