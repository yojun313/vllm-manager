# vLLM Manager: model serving settings.
#
# You normally do not edit this file by hand. `./vllm configure` (or the installer) writes it, and every
# value can be changed later in the web console under System > Server settings.

# Base vLLM image. Pick a tag built for a CUDA version your NVIDIA driver supports.
# The "-cu129" tags run on driver 575 and newer; untagged recent images are built for CUDA 13 (driver 580+).
# Tags: https://hub.docker.com/r/vllm/vllm-openai/tags
VLLM_IMAGE=vllm/vllm-openai:v0.29.0-cu129

# Optional image with vllm[audio] added, used for regular models when set. Built automatically if missing.
# Example: local/vllm-audio:0.29.0-cu129
VLLM_AUDIO_IMAGE=

# Optional vLLM-Omni image. Built automatically if missing. Leave empty to disable Omni.
# Example: local/vllm-omni:0.29.0-cu129
VLLM_OMNI_IMAGE=

# Where downloaded models live (seen as /models inside the containers)
MODELS_DIR=

# Where models referenced by Hugging Face repo id are downloaded automatically
HF_CACHE_DIR=

# torch.compile / CUDA graph cache. Makes the second start of a model faster.
VLLM_CACHE_DIR=

# GPUs to use. GPU_IDS (a list such as 0,2) wins over GPU_COUNT (the first N). Leave both empty for all GPUs.
GPU_COUNT=
GPU_IDS=

# Model port = PORT_BASE + index of the model's first GPU (GPU0 -> 8000, GPU1 -> 8001, GPU0,1 -> 8000)
PORT_BASE=8000

# Where model ports listen. 0.0.0.0 = reachable from outside, 127.0.0.1 = this host only
BIND_ADDR=0.0.0.0

# ---- automatic memory planning (lib/plan.py)
# The KV cache is sized to hold KV_CONCURRENCY requests of max-model-len tokens. Override per model with `# concurrency: N`.
KV_CONCURRENCY=4
# With `max-model-len: auto`, the longest context whose KV cache fits in this many GiB is chosen.
AUTO_KV_GIB=16
# Memory left free on every GPU to absorb estimation error (MiB)
SAFETY_MIB=2048
