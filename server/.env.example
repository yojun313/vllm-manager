# vLLM Manager: web console settings.
#
# Written by `./vllm configure` or by the first-run page in the browser. Everything here can be changed later
# in the web console (System > Server settings, Preferences > Admin account).

ADMIN_USERNAME=
# PBKDF2 hash of the password. Never store the password itself; use `./vllm configure` or the web console.
ADMIN_PASS_HASH=
# Signs the session cookie. Generated at setup; changing it signs everyone out.
SESSION_SECRET=
# Days a sign-in lasts
SESSION_DAYS=14
# true = send the session cookie over HTTPS only. Keep false while you reach the console over plain HTTP.
COOKIE_SECURE=false
# Console port and bind address (0.0.0.0 = reachable from outside, 127.0.0.1 = this host only)
PORT=8080
HOST=0.0.0.0

# Optional public address per model port, used by "Copy URL" and the connection examples.
# MODEL_PUBLIC_URL_8000=llm.example.com/v1
