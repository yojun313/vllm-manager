#!/usr/bin/env bash
# vllm: models/*.yaml 설정으로 vLLM OpenAI 호환 서버를 도커로 띄우는 스크립트.
# 사용법은 `./vllm help` 참고.
set -euo pipefail
shopt -s nullglob   # models/ 가 비어 있어도 *.yaml 이 글자 그대로 남지 않도록

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
CONFIG_DIR="$ROOT/models"
LABEL=vllm-serve.gpus

SERVER_DIR="$ROOT/server"
RUN_DIR="$SERVER_DIR/data"
export PATH="$HOME/.local/bin:$PATH"

# 루트 .env 가 없어도 되는 명령 (설치·설정·관리 서버 제어)
case "${1:-}" in
    configure|doctor|server|update|version|demo|hf-login|-h|--help|help) NEEDS_ENV=0 ;;
    *) NEEDS_ENV=1 ;;
esac
if [[ ! -f "$ROOT/.env" ]] && (( NEEDS_ENV )); then
    python3 "$ROOT/tools/setup.py" --ensure || { echo "❌ 설정 파일을 만들지 못했습니다. ./vllm configure 를 실행하세요." >&2; exit 1; }
fi
if [[ -f "$ROOT/.env" ]]; then
    set -a
    # shellcheck source=.env
    source "$ROOT/.env"
    set +a
fi

DRY_RUN=0

# 이 도구가 쓰는 GPU 번호 목록 (.env 의 GPU_IDS > GPU_COUNT > 감지된 전체)
gpu_ids() {
    if [[ -z "${_GPU_IDS:-}" ]]; then
        local all; all=$(nvidia-smi --query-gpu=index --format=csv,noheader | tr -d ' ')
        if [[ -n "${GPU_IDS:-}" ]]; then
            local g
            for g in ${GPU_IDS//,/ }; do
                grep -qx "$g" <<<"$all" || { echo "❌ .env 의 GPU_IDS 에 없는 GPU 번호가 있습니다: $g (감지된 GPU: $(paste -sd, <<<"$all"))" >&2; exit 1; }
            done
            _GPU_IDS=$(tr ',' '\n' <<<"$GPU_IDS" | sed '/^$/d')
        elif [[ -n "${GPU_COUNT:-}" ]]; then
            [[ "$GPU_COUNT" =~ ^[1-9][0-9]*$ ]] || { echo "❌ .env 의 GPU_COUNT 가 올바르지 않습니다: $GPU_COUNT" >&2; exit 1; }
            _GPU_IDS=$(head -n "$GPU_COUNT" <<<"$all")
        else
            _GPU_IDS=$all
        fi
    fi
    echo "$_GPU_IDS"
}
gpu_count() { gpu_ids | grep -c .; }
gpu_total_mib() { nvidia-smi -i "$(gpu_ids | head -1)" --query-gpu=memory.total --format=csv,noheader,nounits; }
is_managed_gpu() { gpu_ids | grep -qx "$1"; }

# ---------------------------------------------------------------- helpers
die()  { echo "❌ $*" >&2; exit 1; }
info() { echo "▶ $*"; }

docker_() {
    if [[ -z "${_DOCKER:-}" ]]; then
        if docker info >/dev/null 2>&1; then _DOCKER="docker"
        elif [[ -n "${VLLM_NO_SUDO:-}" ]]; then die "docker 권한이 없습니다: sudo usermod -aG docker \$USER 후 재로그인하세요"
        else _DOCKER="sudo docker"; fi
    fi
    $_DOCKER "$@"
}

run() {
    if (( DRY_RUN )); then { printf '%q ' "$@"; echo; } >&2; else "$@"; fi
}

config_path() {
    local name="${1%.yaml}"; name="${name%.yml}"
    local f; f="$CONFIG_DIR/$(basename "$name").yaml"
    [[ -f "$f" ]] || die "설정 파일이 없습니다: $f  (목록: ./vllm ls)"
    echo "$f"
}

# "# gpus: N" 주석에서 권장 GPU 수를 읽는다 (없으면 1)
config_gpus() { sed -n 's/^# *gpus: *\([0-9]\+\).*/\1/p' "$1" | head -1 | grep . || echo 1; }
config_engine() { sed -n 's/^# *engine: *\([^ ]*\).*/\1/p' "$1" | head -1 | grep . || echo vllm; }

# served-model-name 의 첫 번째 이름 (없으면 model 값)
config_served_name() {
    local v=""
    # Omni 0.29 파이프라인은 전역 served-model-name을 거부하므로 기본 모델명을 사용합니다.
    if [[ "$(config_engine "$1")" != vllm-omni ]]; then
        v=$(sed -n 's/^served-model-name: *//p' "$1" | head -1)
    fi
    [[ -z "$v" ]] && v=$(sed -n 's/^model: *//p' "$1" | head -1)
    v="${v#[}"; v="${v%%,*}"; v="${v%]}"
    echo "$v" | tr -d ' "'"'"
}

# 실행 중인 vllm 컨테이너: "이름<TAB>GPU<TAB>모델<TAB>포트<TAB>예약MiB<TAB>상태<TAB>ID"
list_containers() {
    docker_ ps -a --filter "label=$LABEL" \
        --format "{{.Names}}\t{{.Label \"$LABEL\"}}\t{{.Label \"vllm-serve.model\"}}\t{{.Label \"vllm-serve.port\"}}\t{{.Label \"vllm-serve.mem\"}}\t{{.Status}}\t{{.ID}}" \
        | awk -F'\t' -v OFS='\t' '{ for (i = 1; i <= NF; i++) if ($i == "") $i = "-"; print }'  # read 가 빈 칸을 건너뛰지 않도록
}

# models/x.yaml 을 GPU tp 장으로 띄울 때의 메모리 계획 → PLAN_NEED_MIB, PLAN_ARGS, PLAN_DESC
plan() {
    local total; total=$(gpu_total_mib)
    local result
    result=$(python3 "$ROOT/lib/plan.py" "$1" "$MODELS_DIR" "$HF_CACHE_DIR" "$2" "$total") || return $?
    eval "$result"
}

# GPU 한 장의 새 모델용 여유 MiB (계산은 lib/gpufree.py). $2: 교체될 컨테이너 이름(그 몫은 빼고 계산)
gpu_free_mib() {
    list_containers | python3 "$ROOT/lib/gpufree.py" "${2:--}" "$SAFETY_MIB" | awk -v g="$1" '$1 == g { print $2 }'
}

port_in_use() {
    local port="$1" skip="${2:-}" cname _g _m cport _rest
    while IFS=$'\t' read -r cname _g _m cport _rest; do
        [[ -z "$cname" || "$cport" != "$port" ]] && continue
        [[ "$cname" == "$skip" ]] && return 1   # 교체될 컨테이너가 쓰던 포트는 그대로 재사용
        return 0
    done < <(list_containers)
    ss -ltnH "sport = :$port" 2>/dev/null | grep -q .   # 다른 프로그램이 쓰는 포트
}

# Hugging Face CLI: 관리 서버 가상환경(server/.venv)에 함께 설치된 것을 먼저 쓴다
hf_cli() {
    if [[ -x "$SERVER_DIR/.venv/bin/hf" ]]; then echo "$SERVER_DIR/.venv/bin/hf"
    else command -v hf || command -v huggingface-cli || true; fi
}

gpus_overlap() {
    local a b
    for a in ${1//,/ }; do for b in ${2//,/ }; do [[ "$a" == "$b" ]] && return 0; done; done
    return 1
}

# HF 토큰 파일을 컨테이너에 읽기 전용으로 마운트 (명령줄/inspect 에 토큰이 노출되지 않도록)
TOKEN_ARGS=()
if [[ -f "$HOME/.cache/huggingface/token" ]]; then
    TOKEN_ARGS=(-v "$HOME/.cache/huggingface/token:/run/hf_token:ro" -e HF_TOKEN_PATH=/run/hf_token)
fi

# API 키: api-key.env 가 있으면 인증을 켠다 (./vllm key 로 생성)
# --env-file 은 docker CLI 가 읽으므로 키가 명령줄(ps)에 노출되지 않는다
API_KEY_FILE="$ROOT/api-key.env"
AUTH_ARGS=()
[[ -f "$API_KEY_FILE" ]] && AUTH_ARGS=(--env-file "$API_KEY_FILE")

api_key() { [[ -f "$API_KEY_FILE" ]] && sed -n 's/^VLLM_API_KEY=//p' "$API_KEY_FILE"; return 0; }

# 이미지가 없으면 진행률을 보여주며 먼저 받는다 (첫 실행 시 수 GB, 몇 분 걸림)
ensure_image() {
    local image="${1:-$VLLM_IMAGE}"
    (( DRY_RUN )) && return 0
    if docker_ image inspect "$image" >/dev/null 2>&1; then
        info "이미지 준비 완료 (기존 이미지 사용): $image"
        return 0
    fi
    if [[ -n "${VLLM_OMNI_IMAGE:-}" && "$image" == "$VLLM_OMNI_IMAGE" ]]; then
        info "Omni 이미지가 없어 자동 빌드를 시작합니다: $image"
        cmd_omni_build
        return
    fi
    if [[ -n "${VLLM_AUDIO_IMAGE:-}" && "$image" == "$VLLM_AUDIO_IMAGE" ]]; then
        info "오디오 지원 이미지가 없어 자동 빌드를 시작합니다: $image"
        cmd_audio_build
        return
    fi
    info "이미지 다운로드 중: $image (처음 한 번만, 수 분 소요)"
    docker_ pull "$image" || die "이미지를 받지 못했습니다. .env 의 이미지 설정을 확인해야 합니다. Omni 로컬 이미지는 ./vllm omni-build 로 빌드합니다."
}

build_image() {
    local progress=()
    if (( DRY_RUN )) || docker_ buildx version >/dev/null 2>&1; then
        progress=(--progress=plain)
    else
        info "Docker 기본 빌더를 사용합니다. 빌드 출력은 그대로 표시됩니다."
    fi
    BUILDKIT_PROGRESS=plain run docker_ build "${progress[@]}" "$@"
}

cmd_omni_build() {
    [[ -n "${VLLM_OMNI_IMAGE:-}" ]] || die ".env 에 VLLM_OMNI_IMAGE 설정이 필요합니다."
    info "Omni 이미지 빌드 시작: $VLLM_OMNI_IMAGE (기반 이미지: $VLLM_IMAGE)"
    build_image -f "$ROOT/docker/omni.Dockerfile" \
        --build-arg "VLLM_BASE_IMAGE=$VLLM_IMAGE" \
        -t "$VLLM_OMNI_IMAGE" "$ROOT/docker"
    info "Omni 이미지 빌드 완료: $VLLM_OMNI_IMAGE"
}

cmd_audio_build() {
    [[ -n "${VLLM_AUDIO_IMAGE:-}" ]] || die ".env 에 VLLM_AUDIO_IMAGE 설정이 필요합니다."
    info "오디오 지원 vLLM 이미지 빌드 시작: $VLLM_AUDIO_IMAGE"
    build_image -f "$ROOT/docker/audio.Dockerfile" \
        --build-arg "VLLM_BASE_IMAGE=$VLLM_IMAGE" -t "$VLLM_AUDIO_IMAGE" "$ROOT/docker"
    info "오디오 지원 vLLM 이미지 빌드 완료: $VLLM_AUDIO_IMAGE"
}

cmd_setup() {
    info "[1/5] 필수 실행 도구를 확인합니다."
    local tool
    for tool in python3 nvidia-smi docker flock; do
        command -v "$tool" >/dev/null || die "필수 실행 도구가 없습니다: $tool"
    done
    info "[2/5] GPU와 Docker 접근 권한을 확인합니다."
    gpu_ids >/dev/null
    nvidia-smi --query-gpu=index,name,driver_version,memory.total --format=csv,noheader
    docker_ info >/dev/null || die "Docker 데몬에 접근할 수 없습니다."
    info "[3/5] 모델·캐시 디렉터리를 준비합니다."
    mkdir -p "$CONFIG_DIR" "$MODELS_DIR" "$HF_CACHE_DIR" "$VLLM_CACHE_DIR"
    # PM2 재시작이나 수동 실행이 겹쳐도 초기 빌드를 중복 수행하지 않습니다.
    exec 9>"$VLLM_CACHE_DIR/.setup.lock"
    info "초기 환경 준비 잠금을 기다립니다."
    flock 9
    info "[4/5] 일반 vLLM 이미지를 준비합니다."
    ensure_image "$VLLM_IMAGE"
    if [[ -n "${VLLM_AUDIO_IMAGE:-}" ]]; then
        ensure_image "$VLLM_AUDIO_IMAGE"
    fi
    info "[5/5] vLLM-Omni 이미지를 준비합니다."
    if [[ -n "${VLLM_OMNI_IMAGE:-}" ]]; then
        ensure_image "$VLLM_OMNI_IMAGE"
    else
        info "VLLM_OMNI_IMAGE가 비어 있어 Omni 이미지 준비를 생략합니다."
    fi
    flock -u 9
    exec 9>&-
    info "실행 환경 준비가 완료되었습니다."
}

show_gpus() {
    local idx name used total
    while IFS=', ' read -r idx used total name; do
        is_managed_gpu "$idx" || continue
        printf "  GPU%s  %s  실사용 %5.1f / %.0f GiB  → 새 모델용 여유 약 %.1f GiB\n" \
            "$idx" "$name" "$(gib "$used")" "$(gib "$total")" "$(gib "$(gpu_free_mib "$idx")")"
    done < <(nvidia-smi --query-gpu=index,memory.used,memory.total,name --format=csv,noheader,nounits)
}

# ---------------------------------------------------------------- commands
cmd_ls() {
    echo "사용 가능한 모델 설정 (models/*.yaml):"
    local cfgs=("$CONFIG_DIR"/*.yaml) f
    (( ${#cfgs[@]} )) || { echo "  (없음) ./vllm pull <HF repo id> 로 모델을 받으세요"; return 0; }
    for f in "$CONFIG_DIR"/*.yaml; do
        plan "$f" "$(config_gpus "$f")"
        printf "  %-26s GPU %s장  %s\n" "$(basename "$f" .yaml)" "$(config_gpus "$f")" "$PLAN_DESC"
    done
}

cmd_ps() {
    local out
    out=$(list_containers)
    if [[ -z "$out" ]]; then
        echo "실행 중인 vllm 컨테이너가 없습니다."
    else
        { echo -e "CONTAINER\tGPU\tMODEL\tPORT\t예약(GiB)\tSTATUS"
          awk -F'\t' -v OFS='\t' '{ $5 = ($5 ~ /^[0-9]+$/ ? sprintf("%.1f", $5/1024) : "-"); NF = 6; print }' <<<"$out"; } | column -t -s $'\t'
    fi
    echo; show_gpus
}

cmd_up() {
    local model="" gpus="" port="" extra=()
    while (( $# )); do
        case "$1" in
            -g|--gpu|--gpus) gpus="$2"; shift 2 ;;
            -p|--port) port="$2"; shift 2 ;;
            --) shift; extra=("$@"); break ;;
            -*) die "알 수 없는 옵션: $1" ;;
            *) [[ -z "$model" ]] || die "모델은 하나만 지정하세요"; model="$1"; shift ;;
        esac
    done
    [[ -n "$model" ]] || die "모델 이름이 필요합니다. 예: ./vllm up qwen3.5-9b -g 0"

    local cfg; cfg=$(config_path "$model"); model=$(basename "$cfg" .yaml)
    local engine image deploy="" engine_args=() entry_args=() config_mount=()
    engine=$(config_engine "$cfg")
    image="${VLLM_AUDIO_IMAGE:-$VLLM_IMAGE}"
    case "$engine" in
        vllm) ;;
        vllm-omni)
            image="${VLLM_OMNI_IMAGE:-}"
            [[ -n "$image" ]] || die ".env 에 VLLM_OMNI_IMAGE 설정이 필요합니다. (.env.example 참고)"
            deploy=$(sed -n 's/^# *deploy-config: *\([^ ]*\).*/\1/p' "$cfg" | head -1)
            [[ "$deploy" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*\.yaml$ && -f "$ROOT/deploy/$deploy" ]] \
                || die "Omni deploy-config 가 올바르지 않습니다: $deploy (deploy/ 파일명을 지정합니다.)"
            entry_args=(--entrypoint python3)
            ;;
        *) die "지원하지 않는 실행 엔진입니다: $engine" ;;
    esac
    local ngpu; ngpu=$(config_gpus "$cfg")
    [[ -z "$gpus" ]] || [[ "$gpus" =~ ^[0-9]+(,[0-9]+)*$ ]] || die "GPU 지정 형식이 잘못됐습니다: $gpus (예: 0 또는 0,1)"
    [[ -n "$gpus" ]] && ngpu=$(awk -F, '{print NF}' <<<"$gpus")
    [[ -z "$gpus" || "$(tr ',' '\n' <<<"$gpus" | sort -u | wc -l)" -eq "$ngpu" ]] || die "GPU 번호가 중복되었습니다."
    [[ "$engine" != vllm-omni || "$ngpu" -eq "$(config_gpus "$cfg")" ]] || die "Omni 배포 설정은 GPU $(config_gpus "$cfg")장이 필요합니다."
    local g
    for g in ${gpus//,/ }; do
        is_managed_gpu "$g" || die "GPU$g 는 사용하도록 설정되지 않았습니다 (.env 의 GPU_COUNT/GPU_IDS, 사용 가능: $(gpu_ids | paste -sd, -))"
    done
    (( ngpu <= $(gpu_count) )) || die "이 모델은 GPU ${ngpu}장이 필요하지만 사용 가능한 GPU 는 $(gpu_count)장입니다 (.env 의 GPU_COUNT/GPU_IDS)"

    # 필요 메모리 계산
    plan "$cfg" "$ngpu"
    info "메모리 계산: $PLAN_DESC"

    # GPU 자동 선택: 새 모델용 여유가 큰 순서로 ngpu 장
    if [[ -z "$gpus" ]]; then
        gpus=$(for g in $(gpu_ids); do echo "$g $(gpu_free_mib "$g")"; done \
            | sort -k2 -nr | head -n "$ngpu" | awk '{print $1}' | sort -n | paste -sd, -)
    fi
    local tp="$ngpu" name="vllm-$model-g${gpus//,/-}"
    # 교체 대상: 같은 모델 + 같은 GPU 로 떠 있는 컨테이너 (예전 이름 vllm-gpu0 같은 것 포함)
    local old; old=$(list_containers | awk -F'\t' -v m="$model" -v g="$gpus" '$3 == m && $2 == g { print $1; exit }')
    [[ -n "$old" ]] || old="$name"

    # 용량 검사: 하나라도 모자라면 아무것도 건드리지 않고 거부
    local free short=0
    for g in ${gpus//,/ }; do
        free=$(gpu_free_mib "$g" "$old")
        if (( PLAN_NEED_MIB > free )); then
            echo "❌ GPU$g 공간 부족: 필요 $(gib "$PLAN_NEED_MIB")GiB > 여유 $(gib "$free")GiB" >&2
            short=1
        fi
    done
    if (( short )); then
        echo >&2; cmd_ps >&2; echo >&2
        die "띄울 수 없습니다. 다른 GPU(-g)를 쓰거나, ./vllm down <모델> 로 공간을 비우거나, 설정의 max-model-len 을 줄이세요."
    fi

    # 포트: 교체면 기존 포트 재사용, 아니면 PORT_BASE+첫GPU 부터 빈 포트
    if [[ -z "$port" ]]; then
        port=$(docker_ inspect -f '{{index .Config.Labels "vllm-serve.port"}}' "$old" 2>/dev/null || true)
        if [[ -z "$port" ]]; then
            port=$(( PORT_BASE + ${gpus%%,*} ))
            while port_in_use "$port" "$old"; do port=$(( port + 1 )); done
        fi
    elif port_in_use "$port" "$old"; then
        die "포트 $port 는 이미 사용 중입니다. (./vllm ps)"
    fi

    if [[ "$engine" == vllm ]]; then
        engine_args=(--config "/configs/$model.yaml" --tensor-parallel-size "$tp")
        # PLAN_ARGS 는 plan.py 에서 생성한 숫자 옵션만 포함합니다.
        local planned=(); read -r -a planned <<<"$PLAN_ARGS" || true
        engine_args+=("${planned[@]}")
        if (( ${#planned[@]} )); then
            local launch_cfg="$VLLM_CACHE_DIR/launch-configs/$name.yaml"
            if (( ! DRY_RUN )); then
                python3 "$ROOT/lib/launch-config.py" "$cfg" "$launch_cfg" "${planned[@]}"
            fi
            config_mount=(-v "$launch_cfg:/configs/$model.yaml:ro")
        fi
    else
        local ref
        ref=$(sed -n 's/^model: *//p' "$cfg" | head -1 | tr -d '\"'"'" )
        [[ -n "$ref" ]] || die "모델 경로가 없습니다."
        # vLLM/Omni 파서는 serve 바로 다음에 모델 위치 인자를 요구합니다.
        engine_args=(-m vllm_omni.entrypoints.cli.main serve "$ref"
            --omni --deploy-config "/deploy/$deploy")
    fi


    # 이미지 준비가 실패해도 기존 서버는 유지합니다.
    ensure_image "$image"

    # 같은 모델+GPU 조합이 이미 있으면 교체
    if docker_ inspect "$old" >/dev/null 2>&1; then
        info "기존 $old 교체"
        run docker_ rm -f "$old" >/dev/null
    fi

    mkdir -p "$HF_CACHE_DIR" "$VLLM_CACHE_DIR"

    info "모델: $model | 엔진: $engine | GPU: $gpus | 포트: $port | 인증: $([[ -f "$API_KEY_FILE" ]] && echo 켜짐 || echo 꺼짐) | 이미지: $image"
    run docker_ run -d --name "$name" \
        --gpus "\"device=$gpus\"" --ipc=host --restart unless-stopped \
        -p "${BIND_ADDR:-0.0.0.0}:$port:8000" \
        -v "$MODELS_DIR:/models:ro" \
        -v "$HF_CACHE_DIR:/root/.cache/huggingface" \
        -v "$VLLM_CACHE_DIR:/root/.cache/vllm" \
        -v "$CONFIG_DIR:/configs:ro" \
        "${config_mount[@]}" \
        -v "$ROOT/deploy:/deploy:ro" \
        "${TOKEN_ARGS[@]}" "${AUTH_ARGS[@]}" \
        --label "$LABEL=$gpus" --label "vllm-serve.model=$model" --label "vllm-serve.port=$port" \
        --label "vllm-serve.mem=$PLAN_NEED_MIB" \
        --label "vllm-serve.engine=$engine" \
        "${entry_args[@]}" "$image" \
        "${engine_args[@]}" \
        --host 0.0.0.0 --port 8000 \
        "${extra[@]}" >/dev/null
    (( DRY_RUN )) && return 0

    wait_ready "$name" "$port" "$(config_served_name "$cfg")" "$model"
}

wait_ready() {
    local name="$1" port="$2" served="$3" model="$4"
    echo "------------------------------------------------------------"
    echo "로그 표시 중... 준비되면 자동으로 빠져나옵니다 (Ctrl+C 해도 서버는 계속 실행)"
    echo "------------------------------------------------------------"
    docker_ logs -f "$name" 2>&1 &
    local logpid=$!
    trap 'kill $logpid 2>/dev/null; echo; echo "↪ 로그만 닫았습니다. 서버는 백그라운드에서 계속 기동 중: ./vllm logs"; exit 0' INT

    while true; do
        # 기동 중에 한 번이라도 죽었으면 실패로 보고, 재시작 루프를 막기 위해 컨테이너를 지운다
        if [[ "$(docker_ inspect -f '{{.State.Running}} {{.RestartCount}}' "$name" 2>/dev/null)" != "true 0" ]]; then
            sleep 1; kill $logpid 2>/dev/null; trap - INT
            docker_ rm -f "$name" >/dev/null 2>&1 || true
            die "기동에 실패했습니다. 위 로그의 에러를 확인하세요. (컨테이너는 정리했습니다)"
        fi
        if curl -sf "http://localhost:$port/health" >/dev/null 2>&1; then break; fi
        sleep 3
    done
    kill $logpid 2>/dev/null; wait $logpid 2>/dev/null || true; trap - INT

    local auth=""
    [[ -f "$API_KEY_FILE" ]] && auth=" -H \"Authorization: Bearer \$(./vllm key)\""
    cat <<EOF

============================================================
✅ 준비 완료: $name  →  http://localhost:$port/v1
   모델 이름: $served

   curl http://localhost:$port/v1/chat/completions -H 'Content-Type: application/json'$auth \\
     -d '{"model": "$served", "messages": [{"role": "user", "content": "안녕"}]}'

   로그: ./vllm logs $model   종료: ./vllm down $model
============================================================
EOF
}

# 대상: 비우면 전부, "0" / "0,1" 이면 해당 GPU를 쓰는 컨테이너, 그 외엔 모델 별칭 또는 컨테이너 이름
match_targets() {
    local target="${1:-}" cname cgpus cmodel _rest
    while IFS=$'\t' read -r cname cgpus cmodel _rest; do
        [[ -z "$cname" ]] && continue
        if [[ -z "$target" || "$cname" == "$target" || "$cmodel" == "$target" ]] \
            || { [[ "$target" =~ ^[0-9,]+$ ]] && gpus_overlap "$target" "$cgpus"; }; then
            echo "$cname"
        fi
    done < <(list_containers)
}

cmd_down() {
    local targets; targets=$(match_targets "${1:-}")
    [[ -n "$targets" ]] || { echo "종료할 컨테이너가 없습니다."; return 0; }
    local c; for c in $targets; do info "$c 종료"; run docker_ rm -f "$c" >/dev/null; done
}

cmd_logs() {
    local targets; targets=$(match_targets "${1:-}")
    [[ -n "$targets" ]] || die "실행 중인 컨테이너가 없습니다."
    (( $(wc -l <<<"$targets") == 1 )) || die "여러 개가 해당됩니다. 이름으로 지정하세요: $(paste -sd' ' <<<"$targets")"
    docker_ logs -f --tail 200 "$targets"
}

# models/<alias>.yaml 생성. 모델 폴더가 있으면 README/config.json 을 보고 옵션을 채운다
write_config() {
    local repo="$1" alias="${2:-}"
    [[ -n "$alias" ]] || alias=$(tr '[:upper:]' '[:lower:]' <<<"${repo##*/}")
    local f="$CONFIG_DIR/$alias.yaml"
    # new 이후 pull한 경우도 다운로드 완료된 로컬 가중치를 사용합니다.
    local dir="$MODELS_DIR/${repo//\//__}" model_ref="$repo" mdir=""
    [[ -d "$dir" ]] && { model_ref="/models/${repo//\//__}"; mdir="$dir"; }
    if [[ -e "$f" ]]; then
        if [[ -n "$mdir" && -f "$dir/config.json" ]]; then
            python3 "$ROOT/lib/localize-config.py" "$f" "$repo" "$model_ref"
        fi
        echo "ℹ️  기존 모델 설정을 사용합니다: $f"
        return 0
    fi

    # 받아둔 폴더(org__name)가 있으면 그걸 쓰고, 없으면 repo id 로 (up 할 때 hf-cache 로 자동 다운로드)
    local gpu_gib
    gpu_gib=$(gpu_total_mib | awk '{print $1/1024}')

    python3 "$ROOT/lib/gen-config.py" "$repo" "$mdir" "$model_ref" "$gpu_gib" "$(gpu_count)" >"$f.tmp" && mv "$f.tmp" "$f" \
        || { rm -f "$f.tmp"; die "설정 파일 생성 실패"; }
    echo "✅ 설정 파일 생성: $f"
    echo "------------------------------------------------------------"
    cat "$f"
    echo "------------------------------------------------------------"
    echo "실행: ./vllm up $alias"
}

gib() { awk -v m="$1" 'BEGIN { printf "%.1f", m / 1024 }'; }

# 다운로드 전에 HF 정보(config.json, 파일 크기)만으로 "가장 가볍게 띄워도"(컨텍스트 4k, 동시 1) 필요한 메모리를 계산
# → FIT=ok|no|unknown, FIT_MSG, FIT_JSON(웹 관리 화면용)
fit_check() {
    local repo="$1" tmp total ngpu cap n1 d1 nn dn
    if [[ "${repo,,}" == *qwen3-omni-30b-a3b* ]]; then
        FIT=unknown
        FIT_MSG="vLLM-Omni 단계별 배포 모델입니다. 일반 TP 메모리 추정은 적용하지 않습니다. 기본 설정은 GPU 2장, GPU당 90% 예약입니다."
        FIT_JSON='{"fit":"unknown","message":"vLLM-Omni 단계별 배포 모델입니다. 기본 설정은 GPU 2장, GPU당 90% 예약이며 실제 추론 검증이 필요합니다.","engine":"vllm-omni","gpus":2}'
        return 0
    fi
    tmp=$(mktemp --suffix=.yaml)
    printf 'model: %s\nmax-model-len: 4096\n# concurrency: 1\n' "$repo" >"$tmp"
    total=$(gpu_total_mib)
    ngpu=$(gpu_count)
    cap=$(( total - SAFETY_MIB ))
    plan "$tmp" 1;       n1=$PLAN_NEED_MIB; d1=$PLAN_DESC
    plan "$tmp" "$ngpu"; nn=$PLAN_NEED_MIB; dn=$PLAN_DESC
    rm -f "$tmp"
    if [[ "$d1" == ⚠️* ]]; then
        FIT=unknown; FIT_MSG="필요 메모리를 계산할 수 없습니다 (HF 에서 config.json/가중치 크기를 못 읽음)"
    elif (( n1 <= cap )); then
        FIT=ok; FIT_MSG="GPU 1장으로 띄울 수 있습니다 (최소 $(gib "$n1") GiB · $d1)"
    elif (( nn <= cap )); then
        FIT=ok; FIT_MSG="GPU ${ngpu}장이 필요합니다 (최소 GPU당 $(gib "$nn") GiB · $dn)"
    else
        FIT=no; FIT_MSG="GPU ${ngpu}장을 다 써도 띄울 수 없습니다: 최소 GPU당 $(gib "$nn") GiB 필요 > 한 장 $(gib "$cap") GiB ($dn)"
    fi
    FIT_JSON=$(python3 -c '
import json, sys
fit, msg, n1, nn, cap, ngpu = sys.argv[1:7]
print(json.dumps({"fit": fit, "message": msg, "need1_mib": int(n1), "need_all_mib": int(nn),
                  "cap_mib": int(cap), "gpus": int(ngpu)}, ensure_ascii=False))' "$FIT" "$FIT_MSG" "$n1" "$nn" "$cap" "$ngpu")
}

cmd_fit() {
    local repo="${1:-}"
    repo="${repo#https://huggingface.co/}"; repo="${repo%/}"
    [[ "$repo" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || die "HF repo id 형식이 아닙니다: '$repo'"
    fit_check "$repo"
    if [[ "${2:-}" == "--json" ]]; then echo "$FIT_JSON"; else echo "$FIT_MSG"; fi
}

cmd_pull() {
    local repo="" alias="" force=0
    while (( $# )); do
        case "$1" in
            -f|--force|-y|--yes) force=1; shift ;;
            -*) die "알 수 없는 옵션: $1" ;;
            *) if [[ -z "$repo" ]]; then repo="$1"; else alias="$1"; fi; shift ;;
        esac
    done
    [[ -n "$repo" ]] || read -rp "Hugging Face repo id (예: Qwen/Qwen3-8B): " repo
    repo="${repo#https://huggingface.co/}"; repo="${repo%/}"
    [[ "$repo" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || die "HF repo id 형식이 아닙니다: '$repo' (예: Qwen/Qwen3-8B)"

    local hf; hf=$(hf_cli)
    [[ -n "$hf" ]] || die "Hugging Face 다운로드 도구가 없습니다. ./vllm doctor 로 설치 상태를 확인하세요."
    local dir="$MODELS_DIR/${repo//\//__}"

    # 이 서버 GPU 로 띄울 수 없는 모델이면 받기 전에 확인
    info "필요 메모리 확인 중 (HF 정보 기준, 아직 받지 않음)"
    fit_check "$repo"
    case "$FIT" in
        ok) echo "   ✅ $FIT_MSG" ;;
        unknown) echo "   ⚠️  $FIT_MSG" ;;
        no)
            echo "   ❌ $FIT_MSG"
            if (( ! force )); then
                if [[ -t 0 ]]; then
                    local ans; read -rp "   그래도 다운로드할까요? [y/N] " ans
                    [[ "$ans" =~ ^[Yy] ]] || die "다운로드를 취소했습니다."
                else
                    die "띄울 수 없는 모델이라 받지 않습니다. 그래도 받으려면 --force 를 붙이세요."
                fi
            fi ;;
    esac

    info "다운로드: $repo → $dir"
    echo "   (중간에 끊겨도 같은 명령을 다시 실행하면 이어서 받습니다)"
    # vLLM 이 안 쓰는 원본(original)/애플(metal)/ONNX/OpenVINO 가중치는 제외
    run "$hf" download "$repo" --local-dir "$dir" --exclude "original/*" "metal/*" "onnx/*" "openvino/*" \
        || die "다운로드 실패. gated 모델이면 HF 에서 승인받고 'hf auth login' 했는지 확인하세요."
    (( DRY_RUN )) && return 0
    [[ -f "$dir/config.json" ]] || echo "⚠️  config.json 이 없습니다. vLLM 이 지원하는 모델 형식인지 확인하세요."

    write_config "$repo" "$alias"
}

cmd_new() {
    local repo="${1:-}"
    [[ "$repo" == */* ]] || die "HF repo id 가 필요합니다. 예: ./vllm new Qwen/Qwen3-8B"
    write_config "$repo" "${2:-}"
}

# models/<alias>.yaml 의 가중치 위치: /models/X → MODELS_DIR/X, HF repo id → hf-cache 의 해당 repo
model_files_dir() {
    local m; m=$(sed -n 's/^model: *//p' "$1" | head -1 | tr -d "'\"")
    if [[ "$m" == /models/* ]]; then echo "$MODELS_DIR/${m#/models/}"
    elif [[ "$m" == */* ]]; then echo "$HF_CACHE_DIR/hub/models--${m//\//--}"
    fi
}

cmd_rm() {
    local alias="" files=0
    while (( $# )); do
        case "$1" in
            --files) files=1; shift ;;
            -*) die "알 수 없는 옵션: $1" ;;
            *) alias="$1"; shift ;;
        esac
    done
    [[ -n "$alias" ]] || die "사용법: ./vllm rm <모델> [--files]   (--files: 가중치 파일까지 삭제)"
    local cfg; cfg=$(config_path "$alias"); alias=$(basename "$cfg" .yaml)

    local running; running=$(list_containers | awk -F'\t' -v m="$alias" '$3 == m { print $1 }' | paste -sd' ' - || true)
    [[ -z "$running" ]] || die "실행 중인 모델은 지울 수 없습니다. 먼저 끄세요: ./vllm down $alias  ($running)"

    if (( files )); then
        local dir; dir=$(model_files_dir "$cfg")
        local shared; shared=$(grep -l -x -F "$(grep -m1 '^model:' "$cfg")" "$CONFIG_DIR"/*.yaml | grep -v -x -F "$cfg" | xargs -r -n1 basename | sed 's/\.yaml$//' | paste -sd' ' - || true)
        if [[ -z "$dir" ]]; then
            echo "⚠️  가중치 위치를 알 수 없어 설정 파일만 지웁니다."
        elif [[ -n "$shared" ]]; then
            echo "⚠️  다른 설정($shared)도 같은 가중치를 써서 파일은 남겨둡니다: $dir"
        elif [[ ! -e "$dir" ]]; then
            echo "ℹ️  가중치 폴더가 이미 없습니다: $dir"
        else
            # 안전장치: 반드시 MODELS_DIR 또는 HF_CACHE_DIR 바로 아래 폴더만 지운다
            local real parent; real=$(readlink -f "$dir"); parent=$(dirname "$real")
            [[ "$parent" == "$(readlink -f "$MODELS_DIR")" || "$parent" == "$(readlink -f "$HF_CACHE_DIR")/hub" ]] \
                || die "모델 저장소 밖의 경로라 지우지 않습니다: $real"
            [[ "$real" != "$(readlink -f "$HF_CACHE_DIR")" && "$real" != "$(readlink -f "$VLLM_CACHE_DIR")" ]] \
                || die "캐시 폴더 자체는 지우지 않습니다: $real"
            local size; size=$(du -sh "$real" 2>/dev/null | cut -f1)
            info "가중치 삭제: $real ($size)"
            if ! run rm -rf -- "$real" 2>/dev/null; then
                # 컨테이너(root)가 만든 파일이 섞여 있으면 docker 로 지운다
                info "권한이 없는 파일이 있어 docker 로 지웁니다"
                run docker_ run --rm -v "$parent:/p" --entrypoint rm "$VLLM_IMAGE" -rf -- "/p/$(basename "$real")" \
                    || die "가중치 삭제 실패: $real"
            fi
            echo "✅ $size 확보"
        fi
    fi
    run rm -f -- "$cfg"
    echo "✅ 모델 설정 삭제: $cfg"
}

cmd_key() {
    case "${1:-}" in
        "")
            [[ -f "$API_KEY_FILE" ]] || die "API 키가 없습니다 (인증 꺼짐). 생성: ./vllm key new"
            api_key ;;
        new)
            local key; key="sk-$(head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
            ( umask 077; echo "VLLM_API_KEY=$key" >"$API_KEY_FILE" )
            echo "✅ 새 API 키를 만들었습니다 ($API_KEY_FILE, 권한 600):" >&2
            echo "$key"
            echo "   실행 중인 서버에는 다시 up 해야 적용됩니다." >&2 ;;
        off)
            rm -f "$API_KEY_FILE"
            echo "🔓 API 키를 지웠습니다. 다음 up 부터 인증 없이 뜹니다." ;;
        *) die "사용법: ./vllm key [new|off]" ;;
    esac
}

cmd_interactive() {
    local cfgs=("$CONFIG_DIR"/*.yaml) i
    (( ${#cfgs[@]} )) || die "모델 설정이 없습니다. 먼저 받으세요: ./vllm pull <HF repo id>"
    echo "============================================================"
    echo " vLLM 서버 ($VLLM_IMAGE)"
    echo "============================================================"
    local running; running=$(list_containers)
    [[ -n "$running" ]] && { echo "실행 중:"; echo "$running" | awk -F'\t' '{printf "  %-22s GPU %-4s :%s\n", $3, $2, $4}'; echo; }
    show_gpus; echo
    for i in "${!cfgs[@]}"; do
        plan "${cfgs[$i]}" "$(config_gpus "${cfgs[$i]}")"
        printf "  [%d] %-26s GPU %s장 × %5.1f GiB\n" "$i" "$(basename "${cfgs[$i]}" .yaml)" \
            "$(config_gpus "${cfgs[$i]}")" "$(gib "$PLAN_NEED_MIB")"
    done
    local choice; read -rp "모델 번호: " choice
    [[ "$choice" =~ ^[0-9]+$ && -n "${cfgs[$choice]:-}" ]] || die "잘못된 번호입니다."
    local cfg="${cfgs[$choice]}"
    local gpus; read -rp "GPU (예: 0, 1, 0,1) [엔터 = 자동 선택]: " gpus
    if [[ -n "$gpus" ]]; then cmd_up "$(basename "$cfg" .yaml)" -g "$gpus"; else cmd_up "$(basename "$cfg" .yaml)"; fi
}

# ---------------------------------------------------------------- 관리 서버·설치
need_uv() {
    command -v uv >/dev/null || die "uv 가 없습니다. 설치: curl -LsSf https://astral.sh/uv/install.sh | sh"
}
console_port() { sed -n 's/^PORT=//p' "$SERVER_DIR/.env" 2>/dev/null | tail -1 | tr -d '[:space:]'; }
console_pid() {
    local pid; pid=$(cat "$RUN_DIR/console.pid" 2>/dev/null || true)
    [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && echo "$pid"
}
console_url() {
    local host; host=$(sed -n 's/^HOST=//p' "$SERVER_DIR/.env" 2>/dev/null | tail -1)
    if [[ "$host" == 127.0.0.1 ]]; then echo "http://127.0.0.1:$(console_port)"
    else echo "http://$(hostname -I 2>/dev/null | awk '{print $1}' | grep . || echo localhost):$(console_port)"; fi
}

cmd_server() {
    local action="${1:-status}"
    mkdir -p "$RUN_DIR"
    case "$action" in
        start|run)   # 이 터미널에서 실행 (Ctrl+C 로 종료)
            need_uv
            python3 "$ROOT/tools/setup.py" --ensure
            exec bash "$SERVER_DIR/start.sh" ;;
        up)
            need_uv
            if console_pid >/dev/null; then echo "관리 서버가 이미 실행 중입니다: $(console_url)"; return 0; fi
            python3 "$ROOT/tools/setup.py" --ensure
            : >"$RUN_DIR/console.log"
            setsid nohup bash "$SERVER_DIR/start.sh" >>"$RUN_DIR/console.log" 2>&1 </dev/null &
            echo $! >"$RUN_DIR/console.pid"
            # 초기 설정 주소(토큰 포함)나 오류가 보이도록 잠시 로그를 기다린다
            local i
            for i in $(seq 1 60); do
                console_pid >/dev/null || { tail -n 20 "$RUN_DIR/console.log"; die "관리 서버를 시작하지 못했습니다. 위 로그를 확인하세요."; }
                grep -q "관리 웹 서버를 시작합니다" "$RUN_DIR/console.log" && break
                sleep 1
            done
            sleep 2
            grep -A6 "초기 설정이 필요합니다" "$RUN_DIR/console.log" | sed "s#<이 서버 주소 / this host>:[0-9]*#$(console_url | sed 's#http://##')#" || true
            echo "✅ 관리 서버 실행 중: $(console_url)"
            echo "   로그: ./vllm server logs   중지: ./vllm server down" ;;
        down|stop)
            local pid; pid=$(console_pid || true)
            if [[ -z "$pid" ]]; then echo "백그라운드로 실행 중인 관리 서버가 없습니다."; return 0; fi
            kill -TERM -- "-$pid" 2>/dev/null || kill "$pid" 2>/dev/null || true
            rm -f "$RUN_DIR/console.pid"
            echo "관리 서버를 중지했습니다. (실행 중인 모델은 그대로 유지됩니다)" ;;
        restart) cmd_server down; sleep 1; cmd_server up ;;
        status)
            if console_pid >/dev/null; then echo "실행 중 · $(console_url) · PID $(console_pid)"
            else echo "백그라운드로 실행 중이 아닙니다 (시작: ./vllm server up)"; fi ;;
        logs)
            [[ -f "$RUN_DIR/console.log" ]] || die "로그가 없습니다. 먼저 ./vllm server up 을 실행하세요."
            exec tail -n 200 -f "$RUN_DIR/console.log" ;;
        enable)   # 부팅 시 자동 시작 (systemd 사용자 서비스, sudo 불필요)
            command -v systemctl >/dev/null || die "systemd 가 없는 시스템입니다."
            local unit="$HOME/.config/systemd/user/vllm-manager.service"
            mkdir -p "$(dirname "$unit")"
            cat >"$unit" <<EOF
[Unit]
Description=vLLM Manager web console
After=network-online.target docker.service

[Service]
ExecStart=/usr/bin/env bash $SERVER_DIR/start.sh
WorkingDirectory=$SERVER_DIR
Environment=PATH=$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=10

[Install]
WantedBy=default.target
EOF
            cmd_server down >/dev/null
            systemctl --user daemon-reload
            systemctl --user enable --now vllm-manager.service
            echo "✅ 자동 시작을 등록했습니다 (systemctl --user status vllm-manager)."
            echo "   로그아웃 상태에서도 실행하려면 한 번만: sudo loginctl enable-linger $USER" ;;
        disable)
            systemctl --user disable --now vllm-manager.service 2>/dev/null || true
            rm -f "$HOME/.config/systemd/user/vllm-manager.service"
            echo "자동 시작을 해제했습니다." ;;
        *) die "사용법: ./vllm server [up|down|restart|status|logs|start|enable|disable]" ;;
    esac
}

cmd_update() {
    git -C "$ROOT" pull --ff-only || die "업데이트를 받지 못했습니다. 직접 수정한 파일이 있는지 확인하세요 (git status)."
    need_uv
    uv sync --project "$SERVER_DIR" --python 3.12
    if console_pid >/dev/null; then cmd_server restart
    elif systemctl --user is-active --quiet vllm-manager.service 2>/dev/null; then systemctl --user restart vllm-manager.service; echo "관리 서버를 재시작했습니다."
    else echo "✅ 업데이트 완료. 관리 서버를 재시작하면 적용됩니다."; fi
}

# 설치 상태 점검: 무엇이 빠졌고 어떻게 고치는지 알려준다 (아무것도 바꾸지 않음)
cmd_doctor() {
    local bad=0
    ok()   { echo "  ✅ $*"; }
    warn() { echo "  ⚠️  $*"; }
    fail() { echo "  ❌ $*"; bad=1; }
    echo "vLLM Manager $(cat "$ROOT/VERSION" 2>/dev/null) 설치 점검"
    local t
    for t in git curl python3 flock ss; do
        command -v "$t" >/dev/null && ok "$t" || fail "$t 이(가) 없습니다 (패키지 관리자로 설치: git curl python3 util-linux iproute2)"
    done
    if command -v nvidia-smi >/dev/null && nvidia-smi >/dev/null 2>&1; then
        local driver; driver=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader | head -1)
        ok "NVIDIA 드라이버 $driver · GPU $(nvidia-smi --query-gpu=index --format=csv,noheader | wc -l)장"
        if [[ "${VLLM_IMAGE:-}" == *-cu129* && "${driver%%.*}" -lt 575 ]]; then
            warn "기본 이미지(-cu129)는 드라이버 575 이상용입니다. 드라이버를 올리거나 맞는 CUDA 버전의 이미지로 바꾸세요 (./vllm configure 또는 웹 설정)."
        fi
    else fail "nvidia-smi 를 실행할 수 없습니다. NVIDIA 드라이버를 설치하세요."; fi
    if ! command -v docker >/dev/null; then fail "Docker 가 없습니다: https://docs.docker.com/engine/install/"
    elif ! docker info >/dev/null 2>&1; then fail "Docker 권한이 없습니다: sudo usermod -aG docker \$USER 실행 후 다시 로그인하세요."
    else
        ok "Docker $(docker version --format '{{.Server.Version}}' 2>/dev/null)"
        if docker info --format '{{json .Runtimes}}' 2>/dev/null | grep -q nvidia || command -v nvidia-ctk >/dev/null; then ok "NVIDIA Container Toolkit"
        else fail "NVIDIA Container Toolkit 이 없습니다: https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/latest/install-guide.html"; fi
        local img
        for img in "${VLLM_IMAGE:-}" "${VLLM_AUDIO_IMAGE:-}" "${VLLM_OMNI_IMAGE:-}"; do
            [[ -z "$img" ]] && continue
            docker image inspect "$img" >/dev/null 2>&1 && ok "이미지 $img" || warn "이미지 $img 가 아직 없습니다 (관리 서버 시작 시 또는 첫 실행 때 자동 준비)"
        done
    fi
    command -v uv >/dev/null && ok "uv $(uv --version | awk '{print $2}')" || fail "uv 가 없습니다: curl -LsSf https://astral.sh/uv/install.sh | sh"
    [[ -n "$(hf_cli)" ]] && ok "Hugging Face 다운로드 도구" || warn "Hugging Face 다운로드 도구가 없습니다: uv sync --project server 로 설치됩니다"
    [[ -f "$HOME/.cache/huggingface/token" ]] && ok "Hugging Face 로그인" || warn "Hugging Face 로그인 안 됨 (승인이 필요한 모델만 해당): ./vllm hf-login"
    if [[ -f "$ROOT/.env" ]]; then
        ok "모델 폴더 ${MODELS_DIR:-?} · 여유 $(df -h --output=avail "${MODELS_DIR:-/}" 2>/dev/null | tail -1 | tr -d ' ')"
    else warn "설정 파일(.env)이 없습니다: ./vllm configure"; fi
    if grep -qE '^ADMIN_(PASS_HASH|PASSWORD)=.+' "$SERVER_DIR/.env" 2>/dev/null; then ok "관리자 계정"
    else warn "관리자 계정이 없습니다: ./vllm configure 를 실행하거나, 관리 서버를 시작해 표시되는 주소에서 만드세요"; fi
    [[ -f "$API_KEY_FILE" ]] && ok "모델 API 인증 켜짐" || warn "모델 API 인증이 꺼져 있습니다 (켜기: ./vllm key new 또는 웹의 시스템 화면)"
    console_pid >/dev/null && ok "관리 서버 실행 중: $(console_url)" || true
    echo
    (( bad )) && { echo "❌ 해결해야 할 항목이 있습니다."; return 1; }
    echo "✅ 필수 항목이 모두 준비됐습니다."
}

cmd_hf_login() {
    local hf; hf=$(hf_cli)
    [[ -n "$hf" ]] || die "Hugging Face 다운로드 도구가 없습니다. 먼저 uv sync --project server 를 실행하세요."
    "$hf" auth login
}

usage() {
    cat <<EOF
사용법: ./vllm [명령]

  (인자 없음)                  대화형으로 모델/GPU 선택 후 실행
  up <모델> [-g 0|1|0,1] [-p 포트] [-- vllm 추가옵션...]
                               모델 실행. 필요 메모리를 계산해 그만큼만 잡고, 여유 있는 GPU 에 같이 띄움.
                               공간이 모자라면 거부. GPU 미지정 시 여유가 큰 GPU 자동 선택, TP = GPU 개수
  down [모델|GPU|이름]         종료 (인자 없으면 전부)
  ps                           실행 중인 서버 + GPU 여유
  logs [모델|GPU|이름]         로그 보기
  ls                           모델 목록 + 필요 메모리
  pull [HF repo id] [별칭]     모델 폴더(MODELS_DIR)에 다운로드 + models/<별칭>.yaml 자동 생성
                               받기 전에 필요 메모리를 계산해 GPU 전부로도 못 띄우면 확인 (--force: 묻지 않음)
  fit <HF repo id>             받지 않고 이 서버에서 띄울 수 있는지만 계산
  new <HF repo id> [별칭]      다운로드 없이 설정 파일만 생성
  rm <모델> [--files]          모델 설정 삭제 (--files: 가중치 파일까지 삭제, 실행 중이면 거부)
  key [new|off]                API 키 보기 / 새로 만들기(인증 켜기) / 지우기(인증 끄기)
  omni-build                   CUDA 버전을 유지하는 별도 vLLM-Omni 이미지를 빌드합니다.
  audio-build                  오디오 디코딩을 지원하는 vLLM 이미지를 빌드합니다.
  setup                        GPU·Docker·디렉터리·일반/Omni 이미지를 자동 준비합니다.

  configure [--yes]            설정 마법사: 저장 폴더·GPU·포트·관리자 계정 (웹의 시스템 화면에서도 변경 가능)
  server [up|down|restart|status|logs|start|enable|disable]
                               웹 관리 화면 실행/중지. enable = 부팅 시 자동 시작
  update                       최신 버전으로 업데이트하고 관리 서버를 재시작
  doctor                       설치 상태 점검 (빠진 것과 해결 방법 안내)
  hf-login                     Hugging Face 로그인 (승인이 필요한 모델용)
  demo                         GPU 없이 가상 데이터로 관리 화면 체험

  -n, --dry-run                실제로 실행하지 않고 docker 명령만 출력

예:
  ./vllm up gpt-oss-20b -g 0 && ./vllm up qwen3-vl-8b -g 0   # GPU0 에 두 모델
  ./vllm up qwen2.5-vl-32b -g 0,1
  ./vllm up gpt-oss-20b -g 1 -- --max-num-seqs 16
  ./vllm pull Qwen/Qwen3-8B && ./vllm up qwen3-8b
EOF
}

# ---------------------------------------------------------------- main
args=()
for a in "$@"; do
    case "$a" in -n|--dry-run) DRY_RUN=1 ;; *) args+=("$a") ;; esac
done
set -- "${args[@]+"${args[@]}"}"

cmd="${1:-}"; shift || true
(( NEEDS_ENV )) && [[ "$cmd" != setup ]] && gpu_ids >/dev/null
case "$cmd" in
    "")               cmd_interactive ;;
    up|start|serve)   cmd_up "$@" ;;
    down|stop)        cmd_down "$@" ;;
    ps|status)        cmd_ps ;;
    logs|log)         cmd_logs "$@" ;;
    ls|list)          cmd_ls ;;
    new)              cmd_new "$@" ;;
    rm|delete)        cmd_rm "$@" ;;
    pull|download)    cmd_pull "$@" ;;
    fit)              cmd_fit "$@" ;;
    key)              cmd_key "$@" ;;
    omni-build)       cmd_omni_build ;;
    audio-build)      cmd_audio_build ;;
    setup)            cmd_setup ;;
    configure)        exec python3 "$ROOT/tools/setup.py" "$@" ;;
    server|console)   cmd_server "$@" ;;
    update|upgrade)   cmd_update ;;
    doctor|check)     cmd_doctor ;;
    hf-login)         cmd_hf_login ;;
    demo)             need_uv; exec uv run --quiet --project "$SERVER_DIR" --python 3.12 python "$ROOT/tools/demo.py" "$@" ;;
    version)          cat "$ROOT/VERSION" ;;
    -h|--help|help)   usage ;;
    *)                die "알 수 없는 명령: $cmd (./vllm help)" ;;
esac
